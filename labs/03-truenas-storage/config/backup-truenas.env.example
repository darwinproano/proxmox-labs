# Copiar a /etc/truenas-backup.env (chmod 600). NO subir el archivo real.
TRUENAS_HOST=192.168.18.15
TRUENAS_USER=backupuser
# Ajustar a rutas REALES en TrueNAS, comprobadas con SSH.
TRUENAS_SMB_PATH=/mnt/pool1/smb-compartida
TRUENAS_NFS_PATH=/mnt/pool1/nfs-seguridad
BACKUP_DIR=/mnt/pve/HDD-Backups/TrueNAS-2Backup
SSH_KEY=/root/.ssh/id_ed25519
MIN_AGE_HOURS=144
# Opcional: solo si se configura el script de S3
S3_BUCKET=REEMPLAZAR_BUCKET
S3_PREFIX=lab03/truenas
AWS_PROFILE=truenas-backup
